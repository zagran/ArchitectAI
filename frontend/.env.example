# ArchitectAI Frontend Environment Configuration
# Copy this file to .env.local and update with your actual values

# API Configuration (REQUIRED)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Application Configuration
NEXT_PUBLIC_APP_NAME=ArchitectAI
NEXT_PUBLIC_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=development

# Authentication
NEXT_PUBLIC_JWT_STORAGE_KEY=architectai_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=architectai_refresh_token

# Feature Flags
NEXT_PUBLIC_ENABLE_TEMPLATES=true
NEXT_PUBLIC_ENABLE_COST_ANALYSIS=true
NEXT_PUBLIC_ENABLE_IMPLEMENTATION_PLANNING=true
NEXT_PUBLIC_ENABLE_DIAGRAM_GENERATION=true

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
NEXT_PUBLIC_ALLOWED_FILE_TYPES=pdf,doc,docx,txt,png,jpg,jpeg,svg

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_HOTJAR_ID=

# Error Tracking (Optional)
NEXT_PUBLIC_SENTRY_DSN=

# Performance Monitoring (Optional)
NEXT_PUBLIC_PERFORMANCE_MONITORING=false
NEXT_PUBLIC_BUNDLE_ANALYZER=false

# Development Settings
NEXT_PUBLIC_DEBUG=false
NEXT_PUBLIC_MOCK_API=false
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Social Links (Optional)
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-username/architectai
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Contact Information (Optional)
NEXT_PUBLIC_SUPPORT_EMAIL=support@architectai.com
NEXT_PUBLIC_COMPANY_NAME=ArchitectAI

# Regional Settings
NEXT_PUBLIC_DEFAULT_REGION=us-east-1
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DATE_FORMAT=MM/DD/YYYY

# Theme Configuration
NEXT_PUBLIC_DEFAULT_THEME=light
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Maps and Location Services (if needed)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Notification Settings
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_NOTIFICATION_DURATION=5000
